  "info": {
    "description": "Public-data FX research desk.",
    "title": "FX Risk Desk",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/options/scenario": {
      "get": {
        "operationId": "getOptionScenario",
        "parameters": [
          {
            "in": "query",
            "name": "strike",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "maximum": 10,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Strike"
            }
          },
          {
            "in": "query",
            "name": "maturity_days",
            "required": false,
            "schema": {
              "default": 90,
              "maximum": 730,
              "minimum": 1,
              "title": "Maturity Days",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "volatility",
            "required": false,
            "schema": {
              "default": 0.09,
              "maximum": 2,
              "minimum": 0,
              "title": "Volatility",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "notional",
            "required": false,
            "schema": {
              "default": 1000000,
              "maximum": 100000000,
              "minimum": 1,
              "title": "Notional",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "option_type",
            "required": false,
            "schema": {
              "default": "put",
              "enum": [
                "call",
                "put"
              ],
              "title": "Option Type",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptionScenario"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableRun"
                }
              }
            },
            "description": "The local risk snapshot is unavailable."
          }
        },
        "summary": "Get Option Scenario"
      }
    },
    "/api/v1/runs/latest": {
      "get": {
        "operationId": "getRun",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableRun"
                }
              }
            },
            "description": "The local risk snapshot is unavailable."
          }
        },
        "summary": "Get Run"
      }
    },
    "/api/v1/runs/latest/forecast": {
      "get": {
        "operationId": "getForecast",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 120,
              "maximum": 5000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastSeries"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableRun"
                }
              }
            },
            "description": "The local risk snapshot is unavailable."
          }
        },
        "summary": "Get Forecast"
      }
    },
    "/api/v1/runs/latest/risk": {
      "get": {
        "operationId": "getRisk",
        "parameters": [
          {
            "in": "query",
            "name": "hedge_pct",
            "required": false,
            "schema": {
              "default": "75",
              "enum": [
                "0",
                "25",
                "50",
                "75",
                "100"
              ],
              "title": "Hedge Pct",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 252,
              "maximum": 5000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RiskSeries"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableRun"
                }
              }
            },
            "description": "The local risk snapshot is unavailable."
          }
        },
        "summary": "Get Risk"
      }
    }
  }
}
